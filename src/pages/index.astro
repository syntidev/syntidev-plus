---
import Base from '../layouts/Base.astro';
import Trazo from '../components/ui/Trazo.astro';
import Transformacion from '../components/ui/Transformacion.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Escucha from '../components/sections/Escucha.astro';
import Quien from '../components/sections/Quien.astro';
import Como from '../components/sections/Como.astro';
import Cuaderno from '../components/sections/Cuaderno.astro';
import Piezas from '../components/sections/Piezas.astro';
import Formas from '../components/sections/Formas.astro';
import Principio from '../components/sections/Principio.astro';
import Contacto from '../components/sections/Contacto.astro';
---

<Base>
  <Trazo />
  <Header />
  <main>
    <Hero />
    <Transformacion />
    <Escucha />
    <Quien />
    <Como />
    <Cuaderno />
    <Piezas />
