---
// Lo que dicen los negocios: el caos, puesto en tipografía. La respuesta es la bajada del hero.
import site from '../../content/site.json';
const { hero } = site;
const { escuchamos } = hero;
---

<section class="sec sec--ancha escucha" id="escucha">
  <div class="wrap">
    <h2 class="sec__h revela">{escuchamos.titulo}</h2>
    <ul class="frases">
      {escuchamos.frases.map((f) => <li class="revela">{f}</li>)}
    </ul>
    <p class="escucha__resp revela">{hero.bajada}</p>
  </div>
</section>

<style>
  .sec__h { overflow-wrap: break-word; min-width: 0; }
  .frases { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-6) var(--s-5); }
  .frases li { font: italic 400 var(--fs-frase) / 1.2 var(--fuente-titulo); border-top: var(--borde); padding-top: var(--s-4); }
  .frases li:nth-child(1) { grid-column: 1 / 8; }
  /* `rotate` va aparte de `transform` para que la marea (.revela) no lo pise */
  .frases li:nth-child(2) { grid-column: 7 / 13; rotate: .6deg; }
  .frases li:nth-child(3) { grid-column: 2 / 9; rotate: -.7deg; }
  .frases li:nth-child(4) { grid-column: 8 / 13; rotate: .5deg; }

  .escucha__resp { margin: var(--s-9) 0 0 auto; max-width: 40ch; font: 600 var(--fs-cita) / 1.4 var(--fuente-titulo); color: var(--caribe); }

  @media (max-width: 860px) {
    .frases li:nth-child(n) { grid-column: 1 / -1; rotate: none; }
    .escucha__resp { margin-top: var(--s-7); }
  }
</style>
