---
import site from '../../content/site.json';
const { principio, social } = site;
---

<section class="sec">
  <div class="wrap dos">
    <div class="revela">
      <p class="eti">{principio.etiqueta}</p>
      <h2>{principio.titulo}</h2>
      <p class="dos__texto">{principio.texto}</p>
      <blockquote>{principio.cita}</blockquote>
    </div>
    <div class="social revela">
      <p class="eti">{social.etiqueta}</p>
      <h3>{social.titulo}</h3>
      <p class="dos__texto">{social.texto}</p>
      <a class="btn" href={social.enlace} rel="noopener" target="_blank">{social.enlaceTexto}</a>
    </div>
  </div>
</section>

<style>
  .dos { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--s-8); align-items: start; }
  .dos h2 { font-size: var(--fs-h2); margin: var(--s-3) 0 var(--s-4); max-width: 16ch; }
  .dos__texto { color: var(--grafito); margin-bottom: var(--s-5); }
  blockquote { font: italic 400 var(--fs-cita) / 1.4 var(--fuente-titulo); border-left: var(--linea-acento) solid var(--caribe); padding-left: var(--s-5); }
  .social { border: var(--borde); background: var(--espuma); padding: var(--s-6); }
  .social h3 { font-size: var(--fs-h3); margin: var(--s-3) 0 var(--s-2); }
  @media (max-width: 860px) { .dos { grid-template-columns: minmax(0, 1fr); gap: var(--s-7); } }
</style>
