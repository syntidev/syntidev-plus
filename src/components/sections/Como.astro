---
import site from '../../content/site.json';
const { como } = site;
---

<section class="sec" id="como">
  <div class="wrap">
    <h2 class="sec__h revela">{como.titulo}</h2>

    <ol class="pasos">
      {
        como.pasos.map((p, i) => (
          <li class="paso revela">
            <span class="paso__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* El riel: una línea gruesa que ordena los cuatro pasos */
  .pasos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: var(--linea-gruesa) solid var(--tinta); }
  .paso { padding: var(--s-5) var(--s-5) 0 0; }
  .paso__num { display: block; font: 400 var(--fs-h2) / 1 var(--fuente-mono); color: var(--caribe); margin-bottom: var(--s-4); }
  .paso h3 { font-size: var(--fs-h3); margin-bottom: var(--s-2); }
  .paso p { font-size: var(--fs-peq); color: var(--grafito); max-width: 32ch; }

  @media (max-width: 860px) {
    .pasos { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--s-7); }
  }
  @media (max-width: 520px) { .pasos { grid-template-columns: minmax(0, 1fr); } }
</style>
