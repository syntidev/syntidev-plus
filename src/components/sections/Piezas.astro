---
import site from '../../content/site.json';
const { piezas, contacto } = site;
const demo = `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(piezas.demoMensaje)}`;
---

<section class="sec" id="piezas">
  <div class="wrap">
    <div class="piezas__cab">
      <h2 class="sec__h revela">{piezas.titulo}</h2>
      <p class="piezas__bajada revela">{piezas.bajada}</p>
    </div>

    <div class="ledger">
      {
        piezas.lista.map((p) => (
          <details class="pieza" name="piezas">
            <summary>
              <h3>{p.nombre}</h3>
              <span class={`estado estado--${p.tipo}`}>{p.estado}</span>
            </summary>
            <div class="pieza__cuerpo">
              <p class="pieza__texto">{p.texto}</p>
              {p.adaptado && <p class="pieza__adaptado">{p.adaptado}</p>}
              {p.enlaces.length > 0 && (
                <p class="pieza__enlaces">
                  {p.enlaces.map((e) => (
                    <a href={e.href} rel="noopener" target="_blank">{e.texto}</a>
                  ))}
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>

    <div class="cierre revela">
      <p class="cierre__consejo">{piezas.consejo}</p>
      <a class="btn btn--accion" href={demo} rel="noopener" target="_blank">{piezas.demo}</a>
    </div>
  </div>
</section>

<style>
  .piezas__cab { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-5); align-items: end; margin-bottom: var(--s-8); }
  .piezas__cab .sec__h { grid-column: 1 / 8; margin-bottom: 0; }
  .piezas__bajada { grid-column: 9 / 13; color: var(--grafito); }

  .pieza summary { grid-template-columns: minmax(0, 8fr) minmax(0, 3fr) var(--s-5); }
  .pieza h3 { font-size: var(--fs-h3); }
  .estado { font: 600 var(--fs-peq) var(--fuente-texto); }
  .estado--prod { color: var(--caribe); }
  .estado--dev { color: var(--grafito); }

  .pieza__cuerpo { display: grid; gap: var(--s-3); max-width: 62ch; padding: var(--s-5) 0 var(--s-6); border-bottom: var(--borde); }
  .pieza__texto { color: var(--grafito); }
  .pieza__adaptado { font: italic 400 var(--fs-peq) var(--fuente-titulo); color: var(--caribe); }
  .pieza__enlaces { display: flex; flex-wrap: wrap; gap: var(--s-5); }
  .pieza__enlaces a { display: inline-flex; align-items: center; min-height: var(--toque); font: 600 var(--fs-peq) var(--fuente-texto); color: var(--caribe); text-decoration: underline; text-underline-offset: 3px; }
  .pieza__enlaces a:hover, .pieza__enlaces a:active { color: var(--tinta); }

  .cierre { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-5); margin-top: var(--s-8); }
  .cierre__consejo { font: italic 400 var(--fs-cita) / 1.4 var(--fuente-titulo); max-width: 46ch; }

  @media (max-width: 860px) {
    .piezas__cab { grid-template-columns: minmax(0, 1fr); }
    .piezas__cab .sec__h, .piezas__bajada { grid-column: 1; }
    .pieza summary { grid-template-columns: minmax(0, 1fr) auto var(--s-5); gap: var(--s-4); }
  }
</style>
