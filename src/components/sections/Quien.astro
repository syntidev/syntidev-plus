---
import site from '../../content/site.json';
const { quien } = site;
---

<section class="sec banda puntos" id="quien">
  <div class="wrap">
    <div class="sec__cab revela">
      <h2>{quien.titulo}</h2>
    </div>

    <figure class="firma revela">
      <blockquote>{quien.cita}</blockquote>
      <figcaption><b>{quien.firma}</b> · {quien.cargo}</figcaption>
    </figure>

    <div class="oficios">
      {
        quien.oficios.map((o) => (
          <article class="oficio revela">
            <p class="rotulo">{o.etiqueta}</p>
            <h3>{o.titulo}</h3>
            <p class="oficio__texto">{o.texto}</p>
            {o.origen && <p class="oficio__origen">{o.origen}</p>}
            <p class="oficio__leccion">{o.leccion}</p>
          </article>
        ))
      }
    </div>

    <p class="rotulo invisible__tit">{quien.invisibleTitulo}</p>
    <ul class="invisible">
      {quien.invisible.map((t) => <li class="revela">{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .firma { max-width: var(--ancho-cita); margin-bottom: var(--s-8); }
  .firma blockquote {
    font: 400 var(--fs-cita) / 1.45 var(--fuente-titulo);
    border-left: var(--linea-acento) solid var(--sol);
    padding-left: var(--s-5);
  }
  .firma figcaption { margin: var(--s-4) 0 0 calc(var(--s-5) + var(--linea-acento)); font-size: var(--fs-peq); color: var(--grafito); }
  .firma b { color: var(--tinta); }

  .oficios { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
  .oficio { border-radius: var(--r-tarjeta); background: var(--banda-superficie-luz); box-shadow: var(--e2-banda), var(--luz-borde-banda); }
  .oficio { padding: var(--s-6); display: flex; flex-direction: column; gap: var(--s-3); }
  .oficio h3 { font-size: var(--fs-h3); }
  .oficio__texto { font-size: var(--fs-peq); color: var(--grafito); flex: 1; }
  .oficio__origen { font: 400 var(--fs-eti) / 1.6 var(--fuente-mono); color: var(--grafito); letter-spacing: .02em; }
  .oficio__leccion { font: italic 400 var(--fs-h3) / 1.35 var(--fuente-titulo); color: var(--caribe); border-top: var(--borde); padding-top: var(--s-4); }

  .invisible__tit { margin-top: var(--s-7); }
  .invisible { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--s-3); border-top: var(--borde); }
  .invisible li { padding: var(--s-4) var(--s-4) var(--s-4) 0; border-bottom: var(--borde); font-size: var(--fs-peq); }

  @media (max-width: 860px) {
    .oficios, .invisible { grid-template-columns: minmax(0, 1fr); }
  }
</style>
