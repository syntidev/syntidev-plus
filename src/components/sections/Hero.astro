---
import site from '../../content/site.json';
const { hero } = site;
---

<section class="hero" id="inicio">
  <div class="wrap hero__in">
    <div class="hero__texto">
      <h1 class="hero__titulo">
        {hero.lineas.map((l) => <span class="linea"><span class="linea__in">{l}</span></span>)}
      </h1>
      <p class="hero__remate">{hero.remate}</p>
      <p class="hero__bajada">{hero.bajada}</p>
      <div class="hero__acciones">
        <a class="btn btn--accion" href="#contacto">{hero.ctaPrincipal}</a>
        <a class="btn" href="#cuaderno">{hero.ctaSecundario}</a>
      </div>
    </div>

    <aside class="escucha" aria-label={hero.escuchamos.titulo}>
      <p class="rotulo escucha__tit">{hero.escuchamos.titulo}</p>
      <ul>
        {hero.escuchamos.frases.map((f) => <li>{f}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: var(--s-9) var(--s-8); overflow: hidden; }
  .hero__in { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: var(--s-8); align-items: end; }

  .hero__titulo { font-size: var(--fs-h1); margin: 0 0 var(--s-4); }
  .linea { display: block; overflow: hidden; padding-bottom: .06em; }
  .linea__in { display: block; animation: llega var(--t-lento) var(--ola-suave) both; }
  .linea:nth-child(2) .linea__in { animation-delay: 80ms; }
  @keyframes llega { from { transform: translateY(105%); } to { transform: none; } }

  .hero__remate { font: 600 var(--fs-cita) / 1.3 var(--fuente-titulo); color: var(--caribe); margin-bottom: var(--s-4); }
  .hero__bajada { font-size: var(--fs-cita); line-height: 1.5; color: var(--grafito); max-width: 54ch; font-family: var(--fuente-texto); }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  .escucha { border: var(--borde-tinta); background: var(--espuma); box-shadow: var(--sombra-elevada); }
  .escucha__tit { padding: var(--s-4) var(--s-5); border-bottom: var(--borde-tinta); }
  .escucha li {
    padding: var(--s-4) var(--s-5);
    border-bottom: var(--borde);
    font: italic 400 var(--fs-h3) / 1.35 var(--fuente-titulo);
  }
  .escucha li:last-child { border-bottom: 0; }
  /* Marcador: trazo corto en "sol" (sin carácter de guion) */
  .escucha li::before { content: ''; display: inline-block; width: var(--s-3); height: var(--linea-gruesa); background: var(--sol); margin-right: var(--s-2); vertical-align: middle; }

  @media (max-width: 960px) {
    .hero { padding-block: var(--s-8) var(--s-10); }
    .hero__in { grid-template-columns: minmax(0, 1fr); gap: var(--s-7); }
  }
</style>
