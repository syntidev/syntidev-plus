---
// Hero v2: el titular a la izquierda; a la derecha, el "objeto" que da profundidad:
// pantallas reales de producto (ventana + teléfono) con halo y elevación e3.
// Formas de marca detrás (capa media) con paralaje suave. CSS puro.
import site from '../../content/site.json';
const { hero } = site;
const e = hero.escena;
---

<section class="hero puntos formas" id="inicio">
  <div class="forma f-corchete" aria-hidden="true"><svg viewBox="0 0 100 100"><path class="L" d="M8 92V24Q8 8 24 8H92" /></svg></div>
  <div class="forma f-orbita" aria-hidden="true"><svg viewBox="0 0 100 100"><circle class="c" cx="50" cy="50" r="48" stroke-width="1.6" /></svg></div>
  <div class="forma f-punto" aria-hidden="true"><svg viewBox="0 0 10 10"><circle class="s" cx="5" cy="5" r="5" /></svg></div>

  <div class="wrap hero__in">
    <div class="hero__texto">
      <h1 class="hero__titulo">
        {hero.lineas.map((l) => <span class="linea"><span class="linea__in">{l}</span></span>)}
      </h1>
      <p class="hero__remate">{hero.remate}</p>
      <p class="hero__bajada">{hero.bajada}</p>
      <div class="hero__acciones">
        <a class="btn btn--accion" href="#contacto">{hero.ctaPrincipal}</a>
        <a class="btn" href="#cuaderno">{hero.ctaSecundario}</a>
      </div>
    </div>

    <div class="hero__lado">
      <figure class="escena">
        <div class="halo" aria-hidden="true"></div>
        <div class="ventana">
          <div class="ventana__barra" aria-hidden="true"><i></i><i></i><i></i><span>{e.barra}</span></div>
          <img src="/img/pantallas/activopos-catalogo.webp" width="2049" height="960" alt={e.ventanaAlt} decoding="async" />
        </div>
        <div class="telefono">
          <img src="/img/pantallas/lleva-tienda.webp" width="780" height="1588" alt={e.telefonoAlt} decoding="async" />
        </div>
      </figure>
      <p class="escena__leyenda">{e.leyenda}</p>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: var(--s-9) var(--s-9); }
  .hero__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(var(--s-6), 5vw, var(--s-9)); align-items: center; }

  .hero__titulo { font-size: var(--fs-h1); margin: 0 0 var(--s-4); }
  .linea { display: block; overflow: hidden; padding-bottom: .06em; }
  .linea__in { display: block; animation: llega var(--t-lento) var(--ola-suave) both; }
  .linea:nth-child(2) .linea__in { animation-delay: 80ms; }
  @keyframes llega { from { transform: translateY(105%); } to { transform: none; } }

  .hero__remate { font: 600 var(--fs-cita) / 1.3 var(--fuente-titulo); color: var(--marca); margin-bottom: var(--s-4); }
  .hero__bajada { font-size: var(--fs-cita); line-height: 1.5; color: var(--texto-suave); max-width: 46ch; }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .hero__acciones .btn:not(.btn--accion) { background: rgba(255, 255, 255, .45); border-radius: 6px; }

  /* Escena de producto: ventana + teléfono + halo (elevación e3) */
  .hero__lado { min-width: 0; }
  .escena { position: relative; margin: 0; aspect-ratio: 1.32; container-type: inline-size; }
  .halo {
    position: absolute; left: 6%; top: 2%; width: 88%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 50% 42%, rgba(255, 255, 255, .95), rgba(251, 248, 242, .55) 45%, rgba(246, 241, 231, 0) 70%);
  }
  .ventana {
    position: absolute; right: 0; top: 4%; width: 94%; z-index: 1; overflow: hidden;
    border-radius: var(--r-ventana); background: var(--superficie);
    box-shadow: var(--e3), 0 0 0 1px rgba(14, 47, 61, .06);
  }
  .ventana__barra {
    display: flex; align-items: center; gap: 6px; height: clamp(24px, 6cqi, 34px); padding-inline: var(--s-3);
    background: linear-gradient(180deg, #FFFFFF, #F3EEE4); border-bottom: var(--borde);
  }
  .ventana__barra i { width: 9px; height: 9px; border-radius: 50%; background: var(--linea); }
  .ventana__barra span {
    flex: 1; max-width: 58%; height: 62%; margin-left: var(--s-2); padding-left: var(--s-3);
    display: flex; align-items: center; border-radius: var(--r-pill); background: rgba(14, 47, 61, .06);
    font: 400 clamp(9px, 2cqi, 12px) / 1 var(--fuente-texto); color: var(--texto-suave); white-space: nowrap; overflow: hidden;
  }
  .ventana img { width: 100%; height: auto; }
  .telefono {
    position: absolute; left: 0; bottom: 0; z-index: 2; width: 31%; aspect-ratio: 9 / 18.4;
    padding: clamp(4px, 1.2cqi, 8px); border-radius: clamp(18px, 5.4cqi, 34px);
    background: var(--tinta); box-shadow: var(--e3), inset 0 1px 0 rgba(255, 255, 255, .18);
  }
  .telefono::before {
    content: ''; position: absolute; z-index: 1; top: clamp(8px, 2cqi, 13px); left: 50%; translate: -50% 0;
    width: 28%; height: clamp(5px, 1.4cqi, 9px); border-radius: 9px; background: var(--tinta);
  }
  .telefono img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: clamp(14px, 4.2cqi, 27px); }
  .escena__leyenda { margin-top: var(--s-3); text-align: right; font-size: 13px; color: var(--texto-suave); }

  /* Formas (capa media) */
  .f-corchete { width: clamp(120px, 20cqi, 300px); right: -3cqi; bottom: -4cqi; rotate: 180deg; }
  .f-orbita { width: clamp(180px, 32cqi, 500px); right: 3cqi; top: 6%; }
  .f-punto { width: clamp(14px, 2cqi, 28px); left: 50cqi; top: 14%; }

  @media (prefers-reduced-motion: no-preference) {
    .halo { animation: tf-halo 1.1s var(--ola-suave) both; }
    .ventana { animation: tf-sube 900ms var(--ola-suave) 120ms both; }
    .telefono { animation: tf-tel 900ms var(--ola-suave) 420ms both; }
    @keyframes tf-halo { from { opacity: 0; scale: .85; } }
    @keyframes tf-sube { from { opacity: 0; translate: 0 28px; } }
    @keyframes tf-tel { from { opacity: 0; translate: -18px 36px; rotate: -4deg; } }
    @supports (animation-timeline: view()) {
      .hero { view-timeline: --hero block; }
      .forma {
        animation-name: hero-paralaje; animation-timing-function: linear; animation-fill-mode: both;
        animation-timeline: --hero; animation-range: exit 0% exit 100%;
      }
      .f-corchete { --p: -90px; } .f-orbita { --p: 60px; } .f-punto { --p: -140px; }
      @keyframes hero-paralaje { from { translate: 0 0; } to { translate: 0 var(--p); } }
    }
  }

  @media (max-width: 960px) {
    .hero { padding-block: var(--s-8) var(--s-9); }
    .hero__in { grid-template-columns: minmax(0, 1fr); gap: var(--s-7); }
    .escena__leyenda { text-align: left; }
    .f-orbita { width: 70cqi; right: -20cqi; top: auto; bottom: 4%; }
    .f-punto { left: auto; right: 8cqi; top: 40%; }
  }
</style>
