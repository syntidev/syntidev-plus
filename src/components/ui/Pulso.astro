---
// "El pulso": un campo de barras finas que respiran a ritmos distintos, como el
// latido de un negocio en marcha. Sin JS ni aleatoriedad en el navegador: la
// variedad sale de cruzar ciclos de nth-child con periodos primos (3, 5, 7, 11),
// que no se repiten igual hasta pasadas cientos de barras.
interface Props {
  variante?: 'claro' | 'oscuro';
  barras?: number;
}
const { variante = 'claro', barras = 96 } = Astro.props;
const lista = Array.from({ length: barras }, (_, i) => i);
---

<div class={`pulso pulso--${variante}`} aria-hidden="true">
  {lista.map(() => <span></span>)}
</div>

<style>
  .pulso {
    position: absolute;
    inset: auto 0 0 0;
    height: var(--pulso-alto);
    display: flex;
    align-items: flex-end;
    gap: var(--pulso-hueco);
    padding-inline: var(--margen);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
            mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }
  .pulso span {
    flex: 1;
    height: 100%;
    border-radius: var(--radio-pill) var(--radio-pill) 0 0;
    transform-origin: bottom;
    animation: respira var(--t-pulso-2) var(--ola-marea) infinite alternate both;
  }

  .pulso--claro span { background: var(--caribe); opacity: .14; }
  .pulso--claro span:nth-child(11n + 4) { background: var(--sol); opacity: .45; }
  .pulso--oscuro { height: var(--pulso-alto-banda); top: 0; bottom: auto; transform: scaleY(-1); }
  .pulso--oscuro span { background: var(--sobre-oscuro); opacity: .07; }
  .pulso--oscuro span:nth-child(11n + 4) { background: var(--sol); opacity: .22; }

  /* Altura máxima de cada barra (periodo 3) */
  .pulso span:nth-child(3n + 1) { --tope: .55; }
  .pulso span:nth-child(3n + 2) { --tope: .85; }
  .pulso span:nth-child(3n)     { --tope: .35; }

  /* Duración (periodo 5) */
  .pulso span:nth-child(5n + 1) { animation-duration: var(--t-pulso-1); }
  .pulso span:nth-child(5n + 2) { animation-duration: var(--t-pulso-3); }
  .pulso span:nth-child(5n + 3) { animation-duration: var(--t-pulso-2); }
  .pulso span:nth-child(5n + 4) { animation-duration: var(--t-pulso-4); }

  /* Desfase (periodo 7): nunca suben todas juntas */
  .pulso span:nth-child(7n + 1) { animation-delay: -0.4s; }
  .pulso span:nth-child(7n + 2) { animation-delay: -1.9s; }
  .pulso span:nth-child(7n + 3) { animation-delay: -3.1s; }
  .pulso span:nth-child(7n + 4) { animation-delay: -0.9s; }
  .pulso span:nth-child(7n + 5) { animation-delay: -2.6s; }
  .pulso span:nth-child(7n + 6) { animation-delay: -4.2s; }

  @keyframes respira {
    from { transform: scaleY(.12); }
    to   { transform: scaleY(var(--tope, .6)); }
  }

  @media (max-width: 760px) {
    .pulso span:nth-child(n + 49) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulso span { transform: scaleY(calc(var(--tope, .6) * .6)); }
  }
</style>
