---
// La transformación: por la izquierda llega el caos del negocio (notas torcidas,
// dudas, errores), entra al isotipo de SYNTI, y por la derecha sale ordenado en
// carriles rectos. CSS puro.
// "Lo que sale": 2 carriles, 5 etiquetas por carril, UNA a la vez. Cada etiqueta dura
// 5T y solo se mueve en el primer 20% de su ciclo (el resto está oculta): nunca se enciman.
// Delay = k × T dentro del carril; el segundo carril va desfasado T/2.
import site from '../../content/site.json';
const { transformacion: tf } = site;
---

<div class="tf" aria-label="De problemas sueltos a procesos ordenados">
  <p class="eti tf__eti tf__eti--in">{tf.etiquetaEntrada}</p>
  <p class="eti tf__eti tf__eti--out">{tf.etiquetaSalida}</p>

  <!-- Guías: a la izquierda trazos ondulados e irregulares, a la derecha carriles rectos -->
  <svg class="tf__guias" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
    <path class="guia guia--caos" d="M0,80 C80,40 140,140 220,90 S360,30 430,150 L500,150" />
    <path class="guia guia--caos" d="M0,220 C70,260 150,170 230,230 S360,270 430,150 L500,150" />
    <path class="guia guia--orden" d="M500,150 L560,110 L1000,110" />
    <path class="guia guia--orden" d="M500,150 L560,190 L1000,190" />
  </svg>

  <ul class="tf__caos" aria-label={tf.etiquetaEntrada}>
    {tf.entrada.map((t) => <li><span>{t}</span></li>)}
  </ul>

  <div class="tf__nucleo" aria-hidden="true">
    <svg viewBox="0 0 100 100">
      <g class="nucleo__giro">
        <path d="M 18,18 L 48,18 Q 54,18 54,24 L 54,30 L 30,30 L 30,54 L 24,54 Q 18,54 18,48 Z" />
        <path d="M 82,82 L 52,82 Q 46,82 46,76 L 46,70 L 70,70 L 70,46 L 76,46 Q 82,46 82,52 Z" />
      </g>
      <circle class="nucleo__punto" cx="71" cy="29" r="13" />
      <circle class="nucleo__punto nucleo__punto--2" cx="29" cy="71" r="13" />
    </svg>
  </div>

  <ul class="tf__orden" aria-label={tf.etiquetaSalida}>
    {tf.salida.map((t) => <li><span>{t}</span></li>)}
  </ul>
</div>

<style>
  .tf {
    position: relative;
    container-type: inline-size;
    height: var(--tf-alto);
    overflow: hidden;
    border-block: var(--borde);
    background: var(--espuma);
  }

  .tf__eti { position: absolute; top: var(--s-4); z-index: 3; }
  .tf__eti--in { left: var(--margen); }
  .tf__eti--out { right: var(--margen); color: var(--caribe); }

  /* Guías */
  .tf__guias { position: absolute; inset: 0; width: 100%; height: 100%; }
  .guia { fill: none; vector-effect: non-scaling-stroke; }
  .guia--caos { stroke: var(--coral); stroke-width: 1; stroke-dasharray: 3 6; opacity: .35; }
  .guia--orden { stroke: var(--caribe); stroke-width: 1.5; opacity: .3; }

  /* Núcleo: el isotipo procesa */
  .tf__nucleo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--tf-nucleo);
    height: var(--tf-nucleo);
    translate: -50% -50%;
    z-index: 2;
    background: var(--espuma);
    border-radius: var(--radio-pill);
    box-shadow: 0 0 0 var(--s-3) var(--espuma);
  }
  .tf__nucleo svg { width: 100%; height: 100%; overflow: visible; }
  .nucleo__giro { fill: var(--caribe); transform-origin: 50px 50px; animation: tf-procesa var(--t-proceso) var(--ola-marea) infinite; }
  .nucleo__punto { fill: var(--sol); transform-origin: 50px 50px; animation: tf-late var(--t-proceso) var(--ola-suave) infinite; }
  @keyframes tf-procesa {
    0%, 55% { transform: rotate(0deg); }
    80%, 100% { transform: rotate(90deg); }
  }
  @keyframes tf-late {
    0%, 50%, 100% { transform: scale(1); }
    65% { transform: scale(1.12); }
  }

  .tf__caos li, .tf__orden li {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    will-change: transform, opacity;
  }

  /* ── Caos: notas torcidas que derivan hacia el núcleo, en turnos (2 carriles, 5 por carril) ── */
  .tf__caos li { animation: tf-llega calc(var(--t-turno) * 5) linear infinite both; animation-delay: calc(var(--t-turno) * var(--k)); }
  .tf__caos span {
    display: inline-block;
    padding: var(--s-1) var(--s-3);
    background: var(--espuma);
    border: 1px solid color-mix(in srgb, var(--coral) 60%, transparent);
    border-radius: var(--radio);
    font: italic 400 var(--texto-base) var(--fuente-titulo);
    color: var(--tinta);
    animation: tf-tambalea 2.8s var(--ola-marea) infinite alternate;
  }
  /* Solo se mueve en el primer 20% del ciclo (= T); legible hasta el 85% del recorrido */
  @keyframes tf-llega {
    0%   { transform: translate(var(--margen), var(--y)) rotate(var(--r)); scale: 1; opacity: 0; }
    2%   { opacity: 1; }
    17%  { opacity: 1; scale: 1; }
    20%  { transform: translate(calc(var(--xc, 50cqw) - 50%), calc(var(--yf) - 50%)) rotate(0deg); scale: .4; opacity: 0; }
    100% { transform: translate(calc(var(--xc, 50cqw) - 50%), calc(var(--yf) - 50%)) rotate(0deg); scale: .4; opacity: 0; }
  }
  @keyframes tf-tambalea { from { rotate: -3deg; } to { rotate: 3deg; } }

  /* Carril (arriba/abajo), turno k y giro de cada una de las 10 notas */
  /* cada carril entra al núcleo por su lado (40% / 60%), sin converger al mismo punto */
  .tf__caos li:nth-child(odd)  { --y: calc(var(--tf-alto) * .24); --yf: calc(var(--tf-alto) * .40); }
  .tf__caos li:nth-child(even) { --y: calc(var(--tf-alto) * .64); --yf: calc(var(--tf-alto) * .60); }
  .tf__caos li:nth-child(1)  { --k: 0;   --r: -6deg; }
  .tf__caos li:nth-child(2)  { --k: .5;  --r: 5deg; }
  .tf__caos li:nth-child(3)  { --k: 1;   --r: -3deg; }
  .tf__caos li:nth-child(4)  { --k: 1.5; --r: 7deg; }
  .tf__caos li:nth-child(5)  { --k: 2;   --r: 4deg; }
  .tf__caos li:nth-child(6)  { --k: 2.5; --r: -7deg; }
  .tf__caos li:nth-child(7)  { --k: 3;   --r: 6deg; }
  .tf__caos li:nth-child(8)  { --k: 3.5; --r: -4deg; }
  .tf__caos li:nth-child(9)  { --k: 4;   --r: 3deg; }
  .tf__caos li:nth-child(10) { --k: 4.5; --r: -5deg; }
  .tf__caos li:nth-child(even) span { animation-duration: 3.6s; }

  /* ── Orden (escritorio y móvil): carril secuencial ── */
  .tf__orden li { animation: tf-sale calc(var(--t-turno) * 5) linear infinite both; animation-delay: calc(var(--t-turno) * var(--k)); }
  .tf__orden span {
    display: inline-flex;
    align-items: center;
    padding: var(--s-1) var(--s-3);
    background: var(--espuma);
    border: 1px solid var(--caribe);
    border-radius: var(--radio-pill);
    font: 500 var(--fs-eti) var(--fuente-mono);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--caribe);
  }
  /* Solo se mueve en el primer 20% del ciclo (= T); el resto está oculta */
  /* x0: donde asoma junto al núcleo; x1: tope derecho del carril (la etiqueta nunca se corta) */
  @keyframes tf-sale {
    0%   { transform: translate(calc(50cqw - 50%), calc(var(--tf-alto) / 2 - 50%)); scale: .4; opacity: 0; }
    3%   { transform: translate(min(var(--x0, 56cqw), calc(100cqw - 100% - var(--margen))), calc(var(--carril) - 50%)); scale: 1; opacity: 1; }
    17%  { opacity: 1; }
    20%  { transform: translate(calc(100cqw - 100% - var(--margen)), calc(var(--carril) - 50%)); scale: 1; opacity: 0; }
    100% { transform: translate(calc(100cqw - 100% - var(--margen)), calc(var(--carril) - 50%)); scale: 1; opacity: 0; }
  }
  .tf__orden li:nth-child(odd)  { --carril: calc(var(--tf-alto) * .3667); }
  .tf__orden li:nth-child(even) { --carril: calc(var(--tf-alto) * .6333); }
  /* k × T: carril de arriba 0, T, 2T, 3T, 4T; carril de abajo desfasado T/2 */
  .tf__orden li:nth-child(1)  { --k: 0; }
  .tf__orden li:nth-child(2)  { --k: .5; }
  .tf__orden li:nth-child(3)  { --k: 1; }
  .tf__orden li:nth-child(4)  { --k: 1.5; }
  .tf__orden li:nth-child(5)  { --k: 2; }
  .tf__orden li:nth-child(6)  { --k: 2.5; }
  .tf__orden li:nth-child(7)  { --k: 3; }
  .tf__orden li:nth-child(8)  { --k: 3.5; }
  .tf__orden li:nth-child(9)  { --k: 4; }
  .tf__orden li:nth-child(10) { --k: 4.5; }

  /* ── Móvil: las 10 se muestran en turnos, sin encimarse, y pueden partir en dos líneas ── */
  @media (max-width: 700px) {
    .tf { --tf-alto: var(--tf-alto-movil); }
    .tf__nucleo { width: var(--tf-nucleo-movil); height: var(--tf-nucleo-movil); }
    /* Las notas terminan a la izquierda del núcleo y las etiquetas arrancan a su derecha: nunca se cruzan */
    .tf__orden li, .tf__caos li { white-space: normal; }
    .tf__caos li { max-width: 38cqw; --xc: 40cqw; }
    .tf__orden li { max-width: 34cqw; --x0: 60cqw; }
    .tf__orden span { text-align: center; font-size: var(--fs-eti); }
  }

  /* Sin movimiento: composición quieta y legible, caos a la izquierda, orden a la derecha */
  @media (prefers-reduced-motion: reduce) {
    .tf__caos li, .tf__orden li { animation: none !important; opacity: 1; }
    .tf__caos li { transform: translate(var(--margen), var(--y)) rotate(var(--r)) scale(1); }
    .tf__caos li:nth-child(n + 5), .tf__orden li:nth-child(n + 5) { display: none; }
    .tf__orden li { transform: translate(calc(60cqw), calc(var(--carril) - 50%)); }
    .tf__orden li:nth-child(3) { transform: translate(calc(75cqw), calc(var(--carril) - 50%)); }
    .tf__orden li:nth-child(4) { transform: translate(calc(75cqw), calc(var(--carril) - 50%)); }
  }
</style>
