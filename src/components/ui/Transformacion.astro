---
// La transformación: cada problema del negocio se convierte en su solución.
// Guiada por el scroll (CSS puro, animation-timeline): bajar ordena y voltea las
// notas; subir devuelve al caos. "Espejo": si el visitante ya vio todo ordenado y
// vuelve a subir, la escena le pregunta y le ofrece conversar (script de ~0,5 KB).
// Longhands de animation a propósito: con el shorthand el minificador fusiona
// animation-timeline y Chrome lo descarta (ver global.css, .revela).
import site from '../../content/site.json';
const { transformacion: tf } = site;

// Desorden inicial, en % del tamaño de la carta: [dx, dy] escritorio (4 col),
// [mdx, mdy] móvil (2 col) y giro en grados. Elegidos para que ninguna nota tape a otra.
const desorden = [
  [238, 218, 108, 258, -8], [-92, -12, -103, 0, 6], [119, 29, 103, -101, -5], [-238, 288, -97, 258, 10],
  [173, -115, 0, -101, 7], [238, 69, 5, 157, -11], [-81, 17, 103, -196, 4], [-335, 35, -97, -90, -7],
];
---

<section class="tf" aria-labelledby="tf-titulo">
  <div class="tf__pegado wrap">
    <div class="tf__cab">
      <svg class="tf__iso" viewBox="0 0 100 100" aria-hidden="true">
        <path d="M 18,18 L 48,18 Q 54,18 54,24 L 54,30 L 30,30 L 30,54 L 24,54 Q 18,54 18,48 Z" />
        <path d="M 82,82 L 52,82 Q 46,82 46,76 L 46,70 L 70,70 L 70,46 L 76,46 Q 82,46 82,52 Z" />
        <circle class="tf__punto" cx="71" cy="29" r="13" />
        <circle class="tf__punto" cx="29" cy="71" r="13" />
      </svg>
      <div class="tf__titulos">
        <p class="tf__antes" aria-hidden="true">
          <span class="tf__normal">{tf.tituloAntes}</span><span class="tf__espejo">{tf.tituloEspejo}</span>
        </p>
        <h2 class="tf__despues" id="tf-titulo">{tf.titulo}</h2>
        <a class="btn btn--accion tf__invita" href="#contacto" tabindex="-1">{tf.invita}</a>
      </div>
    </div>

    <ul class="tf__tablero">
      {tf.pares.map((p, i) => {
        const [dx, dy, mdx, mdy, r] = desorden[i % desorden.length];
        return (
          <li class="carta" style={`--i:${i};--dx:${dx};--dy:${dy};--mdx:${mdx};--mdy:${mdy};--r:${r}`}>
            <div class="carta__giro">
              <p class="cara cara--problema" aria-hidden="true">{p.problema}</p>
              <p class="cara cara--solucion">
                <span class="cara__antes">{p.problema}</span>
                <b>{p.solucion}</b>
                <small>{p.beneficio}</small>
              </p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  // Espejo: solo si ya vio la escena completa y está subiendo de vuelta.
  const s = document.querySelector<HTMLElement>('.tf');
  const invita = s?.querySelector<HTMLAnchorElement>('.tf__invita');
  if (s && invita && !matchMedia('(prefers-reduced-motion: reduce)').matches && CSS.supports('animation-timeline: view()')) {
    let y = scrollY;
    let visto = false;
    const avance = () => { const r = s.getBoundingClientRect(); return -r.top / (r.height - innerHeight); };
    addEventListener('scroll', () => {
      const n = scrollY;
      const v = avance();
      if (v >= 0.9) visto = true;
      const espejo = visto && n < y && v < 0.85 && v > -0.2;
      if (espejo) { s.dataset.espejo = ''; invita.tabIndex = 0; }
      else if (n > y) { delete s.dataset.espejo; invita.tabIndex = -1; }
      y = n;
    }, { passive: true });
  }
</script>

<style>
  .tf {
    --tf-k: var(--tf-desorden);
    --carta: var(--tf-carta);
    height: var(--tf-escena);
    view-timeline: --tf block;
    overflow-x: clip;
    background: var(--espuma);
    border-block: var(--borde);
  }
  .tf__pegado {
    /* Pegado bajo la barra de navegación fija */
    position: sticky; top: var(--nav-alto);
    height: calc(100vh - var(--nav-alto)); height: calc(100svh - var(--nav-alto));
    display: grid; align-content: safe center;
    gap: clamp(var(--s-5), 5vh, var(--s-8));
  }

  /* Cabecera: isotipo + títulos superpuestos */
  .tf__cab { display: flex; align-items: center; gap: var(--s-4); }
  .tf__iso { width: var(--iso); height: var(--iso); flex: none; transform-origin: center; }
  .tf__iso path { fill: var(--caribe); }
  .tf__punto { fill: var(--sol); }
  .tf__titulos { display: grid; align-items: center; }
  .tf__antes, .tf__despues {
    grid-area: 1 / 1;
    font: 600 var(--fs-h2) / var(--interlinea-titulo) var(--fuente-titulo);
    text-wrap: balance;
  }
  .tf__despues { color: var(--caribe); }
  .tf__espejo { display: none; color: var(--caribe); }
  .tf[data-espejo] .tf__normal { display: none; }
  .tf[data-espejo] .tf__espejo { display: inline; }
  .tf__invita {
    grid-area: 2 / 1; justify-self: start; margin-top: var(--s-3);
    opacity: 0; visibility: hidden;
    transition: opacity var(--t-rapido) var(--ola-suave), visibility var(--t-rapido);
  }
  .tf[data-espejo] .tf__invita { opacity: 1; visibility: visible; }

  /* Tablero */
  .tf__tablero {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(var(--carta), auto);
    gap: var(--s-4);
    perspective: 1400px;
    margin-bottom: calc(var(--carta) * 1.5);
  }
  .carta { position: relative; z-index: calc(10 - var(--i)); }
  /* Las dos caras se apilan en la misma celda: la tarjeta mide lo que mida su texto más largo */
  .carta__giro { position: relative; height: 100%; display: grid; transform-style: preserve-3d; }
  .cara {
    grid-area: 1 / 1; position: relative; margin: 0;
    backface-visibility: hidden;
    display: flex; align-items: center;
    padding: var(--s-4) var(--s-5);
  }
  .cara--problema {
    background: var(--blanco);
    border: var(--borde);
    border-radius: var(--radio);
    box-shadow: 0 10px 24px -14px rgba(20, 33, 43, .35);
    font: italic 400 var(--fs-cita) / 1.25 var(--fuente-titulo);
    color: var(--tinta);
  }
  /* La cinta adhesiva: lo provisional */
  .cara--problema::before {
    content: ""; position: absolute; top: -9px; left: calc(50% - 32px);
    width: 64px; height: 18px;
    background: var(--sol); opacity: .55;
    transform: rotate(-3deg);
  }
  .cara--solucion {
    transform: rotateY(180deg);
    flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: var(--s-1);
    border-radius: calc(var(--radio) * 2.5);
    background: linear-gradient(160deg, var(--caribe) 0%, var(--mar-noche) 120%);
    color: var(--blanco);
    box-shadow: 0 18px 34px -18px rgba(14, 47, 61, .7);
  }
  .cara--solucion b { font: 600 var(--fs-h3) / 1.2 var(--fuente-texto); }
  .cara--solucion small { font: 400 var(--fs-peq) / 1.35 var(--fuente-texto); color: var(--sobre-oscuro-suave); }
  /* La luz de estado: el sistema encendido */
  .cara--solucion::before {
    content: ""; flex: none; margin-bottom: auto; padding: 0;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--sol);
  }
  .cara__antes { display: none; }

  /* ── Escena (solo con soporte y sin movimiento reducido) ── */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .carta {
        transform: translate(calc(var(--dx) * var(--tf-k) * 1%), calc(var(--dy) * var(--tf-k) * 1%)) rotate(calc(var(--r) * 1deg));
        animation-name: tf-ordena; animation-fill-mode: both; animation-timing-function: var(--ola-suave);
        animation-timeline: --tf;
        animation-range: contain calc(10% + var(--i) * 3%) contain calc(36% + var(--i) * 3%);
      }
      .carta__giro {
        animation-name: tf-voltea; animation-fill-mode: both; animation-timing-function: var(--ola-suave);
        animation-timeline: --tf;
        animation-range: contain calc(56% + var(--i) * 3.5%) contain calc(70% + var(--i) * 3.5%);
      }
      .cara--problema::before {
        animation-name: tf-despega; animation-fill-mode: both; animation-timing-function: ease-in;
        animation-timeline: --tf;
        animation-range: contain calc(48% + var(--i) * 3.5%) contain calc(56% + var(--i) * 3.5%);
      }
      .cara--solucion::before {
        animation-name: tf-enciende; animation-fill-mode: both; animation-timing-function: linear;
        animation-timeline: --tf;
        animation-range: contain calc(58% + var(--i) * 3.5%) contain calc(72% + var(--i) * 3.5%);
      }
      .tf__iso {
        animation-name: tf-gira; animation-fill-mode: both; animation-timing-function: linear;
        animation-timeline: --tf; animation-range: contain 30% contain 75%;
      }
      .tf__antes {
        animation-name: tf-sale-texto; animation-fill-mode: both; animation-timing-function: linear;
        animation-timeline: --tf; animation-range: contain 44% contain 54%;
      }
      .tf__despues {
        animation-name: tf-entra-texto; animation-fill-mode: both; animation-timing-function: linear;
        animation-timeline: --tf; animation-range: contain 52% contain 62%;
      }
    }
  }
  @keyframes tf-ordena { to { transform: none; } }
  @keyframes tf-voltea {
    0% { transform: rotateY(0); }
    50% { transform: translateZ(var(--tf-elevacion)) rotateY(90deg) scale(1.06); }
    100% { transform: rotateY(180deg); }
  }
  @keyframes tf-despega { to { transform: translate(40px, -70px) rotate(38deg); opacity: 0; } }
  @keyframes tf-enciende {
    0%, 60% { box-shadow: 0 0 0 0 rgba(233, 180, 76, 0); }
    80% { box-shadow: 0 0 0 6px rgba(233, 180, 76, .35); }
    100% { box-shadow: 0 0 0 3px rgba(233, 180, 76, .18); }
  }
  @keyframes tf-gira { to { transform: rotate(180deg); } }
  @keyframes tf-sale-texto { to { opacity: 0; translate: 0 -12px; } }
  @keyframes tf-entra-texto { from { opacity: 0; translate: 0 12px; } to { opacity: 1; translate: 0 0; } }

  /* ── Sin escena: estado final legible, problema tachado sobre su solución ── */
  @supports not (animation-timeline: view()) {
    .tf { height: auto; }
    .tf__pegado { position: static; height: auto; padding-block: var(--s-8); }
    .tf__tablero { margin-bottom: 0; grid-auto-rows: auto; }
    .tf__antes, .cara--problema, .cara--solucion::before { display: none; }
    .cara { min-height: var(--carta); }
    .cara--solucion { transform: none; justify-content: center; }
    .cara__antes { display: block; font: italic 400 var(--fs-peq) / 1.3 var(--fuente-titulo); color: var(--sobre-oscuro-suave); text-decoration: line-through; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tf { height: auto; }
    .tf__pegado { position: static; height: auto; padding-block: var(--s-8); }
    .tf__tablero { margin-bottom: 0; grid-auto-rows: auto; }
    .tf__antes, .cara--problema, .cara--solucion::before { display: none; }
    .cara { min-height: var(--carta); }
    .cara--solucion { transform: none; justify-content: center; }
    .cara__antes { display: block; font: italic 400 var(--fs-peq) / 1.3 var(--fuente-titulo); color: var(--sobre-oscuro-suave); text-decoration: line-through; }
  }

  @media (max-width: 760px) {
    .tf { height: var(--tf-escena-movil); --carta: var(--tf-carta-movil); }
    .tf__tablero { grid-template-columns: repeat(2, 1fr); gap: var(--s-3); margin-bottom: calc(var(--carta) * .45); }
    .cara { padding: var(--s-3) var(--s-4); }
    .cara--solucion { gap: 2px; }
    .cara--solucion b { font-size: 16px; }
    .cara--solucion small { font-size: 13px; line-height: 1.3; }
    .tf__pegado { gap: var(--s-4); }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (max-width: 760px) {
      .carta { transform: translate(calc(var(--mdx) * 1%), calc(var(--mdy) * 1%)) rotate(calc(var(--r) * 1deg)); }
    }
  }
</style>
